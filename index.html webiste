<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Keneisha Sanap | Brand Partnerships &amp; Creator Marketing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;500;600;700;900&family=Pinyon+Script&display=swap" rel="stylesheet">
<style>
:root{
  --pink:#F4C9D6; --brown:#4E3227; --latte:#ECDDCF; --latte2:#E2CEBC; --tan:#B08A73; --soft:rgba(78,50,39,.72); --faint:rgba(78,50,39,.5);
  --line:rgba(78,50,39,.14); --tint:rgba(255,255,255,.45); --paper:#FBF5F7;
  --sans:"Albert Sans","Helvetica Neue",Arial,sans-serif; --sig:"Pinyon Script","Snell Roundhand",cursive;
  box-sizing:border-box;
}
*,*::before,*::after{box-sizing:inherit}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--brown);font-family:var(--sans);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
::selection{background:var(--brown);color:var(--pink)}
img{max-width:100%;display:block}
a{color:inherit}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--brown);outline-offset:3px}
.wrap{max-width:980px;margin:0 auto;padding:0 clamp(1.25rem,5vw,2.5rem)}
svg.i{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
b,strong{font-weight:700}

/* HERO (kept from your original) */
.hero{background:var(--pink);min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:space-between;align-items:center;padding:calc(env(safe-area-inset-top,0px) + 3rem) 1.5rem 5rem}
.social{display:flex;gap:2.5rem;opacity:0;animation:fade 1s .4s ease-out forwards}
.social a{display:block;transition:transform .25s,opacity .25s}
.social a:hover{transform:translateY(-3px);opacity:.7}
.center{flex-grow:1;display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%}
.namebox{position:relative;cursor:pointer;user-select:none;-webkit-user-select:none;padding:1.5rem 1rem;-webkit-tap-highlight-color:transparent}
.namestack{position:relative;display:flex;align-items:center;justify-content:center}
.n-sans,.n-ghost{font-family:var(--sans);font-weight:900;font-size:clamp(3rem,9.5vw,8rem);letter-spacing:-.025em;line-height:1;margin:0;white-space:nowrap}
.n-ghost{visibility:hidden}
.n-sans{position:absolute;transition:opacity .3s,transform .3s,filter .3s}
.n-sig{position:absolute;font-family:var(--sig);font-weight:400;font-size:clamp(3.6rem,11vw,10rem);line-height:1.2;white-space:nowrap;margin:-.15em 0 0;clip-path:inset(0 100% 0 0);opacity:0;transition:clip-path 1.5s cubic-bezier(.445,.05,.55,.95),opacity .2s}
.namebox:hover .n-sans,.namebox.on .n-sans{opacity:0;transform:scale(.95);filter:blur(4px)}
.namebox:hover .n-sig,.namebox.on .n-sig{clip-path:inset(0 0 0 0);opacity:1}
.tagline{margin:.25rem 0 0;font-size:clamp(1.05rem,2vw,1.35rem);font-weight:500;text-align:center;opacity:0;animation:rise .8s 1s forwards}
.school{margin:.35rem 0 0;font-size:.95rem;color:var(--soft);text-align:center;opacity:0;animation:rise .8s 1.2s forwards}
.pills{display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem 1rem;opacity:0;animation:fade 1s .7s ease-out forwards}
.pill{position:relative;overflow:hidden;padding:.7rem 1.75rem;border-radius:999px;border:1px solid var(--brown);background:none;cursor:pointer;font-weight:600;font-size:.95rem}
.pill .fill{position:absolute;inset:0;background:var(--brown);transform:scaleX(0);transform-origin:left;transition:transform .3s ease-out}
.pill .t{position:relative;transition:color .3s}
.pill:hover .fill,.pill:focus-visible .fill{transform:scaleX(1)}
.pill:hover .t,.pill:focus-visible .t{color:var(--pink)}
@keyframes fade{to{opacity:1}}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* FLOATING NAV */
.fnav{position:fixed;top:calc(env(safe-area-inset-top,0px) + 1rem);left:50%;z-index:50;max-width:94vw;transform:translate(-50%,-16px);opacity:0;pointer-events:none;transition:opacity .25s,transform .25s}
.fnav.show{opacity:1;transform:translate(-50%,0);pointer-events:auto}
.fnav .bar{display:flex;align-items:center;gap:.25rem;padding:.4rem;border-radius:999px;background:rgba(251,245,247,.97);border:1px solid var(--line);box-shadow:0 4px 14px rgba(78,50,39,.1);overflow-x:auto;scrollbar-width:none}
.fnav .bar::-webkit-scrollbar{display:none}
.fnav .lk{padding:.4rem .9rem;border-radius:999px;border:0;background:none;font-size:.88rem;font-weight:600;white-space:nowrap;cursor:pointer;color:var(--soft);transition:background .2s,color .2s}
.fnav .lk:hover{color:var(--brown)}
.fnav .lk.on{background:var(--brown);color:var(--pink)}

/* SECTIONS */
section{padding:clamp(3.5rem,8vw,5.5rem) 0;border-top:1px solid var(--line)}
#about{border-top:0}
h2{font-size:clamp(1.9rem,4vw,2.6rem);font-weight:700;letter-spacing:-.02em;line-height:1.15;margin:0 0 .4rem}
.lede{margin:0 0 2.5rem;color:var(--soft);max-width:60ch}
h3.group{display:flex;align-items:center;gap:.6rem;font-size:1.3rem;font-weight:700;letter-spacing:-.01em;color:var(--brown);margin:3rem 0 .25rem;padding-bottom:.7rem;border-bottom:2px solid var(--brown)}
h3.group::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--tan);box-shadow:0 0 0 3px rgba(176,138,115,.22)}
h3.group:first-of-type{margin-top:0}

/* About */
.about{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:clamp(1.75rem,5vw,3.5rem);align-items:center}
.about img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:14px}
.about .lead{font-size:clamp(1.3rem,2.6vw,1.65rem);font-weight:600;line-height:1.35;letter-spacing:-.01em;margin:0 0 1rem}
.about p{margin:0 0 1rem;color:var(--soft)}
.about p.lead{color:var(--brown)}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:1.75rem 0;padding:1.25rem 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.stat b{display:block;font-size:clamp(1.4rem,3vw,1.9rem);font-weight:900;line-height:1.1}
.stat span{display:block;margin-top:.2rem;font-size:.85rem;line-height:1.35;color:var(--soft)}
.cta{display:flex;flex-wrap:wrap;gap:.75rem}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.65rem 1.25rem;border-radius:999px;font-weight:600;font-size:.95rem;text-decoration:none;border:1px solid var(--brown)}
.btn.solid{background:var(--brown);color:var(--pink)}
.btn:hover{opacity:.85}

/* Timeline rows */
.row{display:grid;grid-template-columns:150px minmax(0,1fr);gap:1.5rem;padding:1.4rem 0;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.when{font-size:.92rem;font-weight:600;color:var(--soft);padding-top:.15rem}
.row h4{margin:0;font-size:1.15rem;font-weight:700;line-height:1.35}
.row .org{margin:.1rem 0 .55rem;color:var(--soft);font-size:.98rem}
.row ul{margin:0;padding-left:1.1rem}
.row li{margin:.2rem 0}
.row li::marker{color:var(--faint)}

/* Slideshow */
.media{margin-top:1rem;min-width:0}
.fit{display:inline-flex;flex-direction:column;max-width:100%;vertical-align:top}
.fit .frame{align-self:flex-start}
.frame{position:relative;display:inline-block;max-width:100%;vertical-align:top}
.frame img{max-width:100%;max-height:340px;width:auto;height:auto;border-radius:10px;cursor:zoom-in}
.row .frame img{max-height:260px}
.arrow{position:absolute;top:50%;transform:translateY(-50%);width:38px;height:38px;display:grid;place-items:center;border-radius:999px;background:rgba(255,255,255,.92);border:0;box-shadow:0 1px 4px rgba(78,50,39,.25);cursor:pointer;padding:0;opacity:0;transition:opacity .15s}
.arrow svg{width:16px;height:16px;stroke-width:2}
.arrow.prev{left:8px}.arrow.next{right:8px}
.frame:hover .arrow,.frame:focus-within .arrow{opacity:1}
.arrow[disabled]{display:none}
@media (hover:none){.arrow{opacity:1}}
.sbar{display:flex;align-items:center;gap:1rem;margin-top:.55rem;font-size:.88rem;color:var(--soft)}
.count{font-variant-numeric:tabular-nums}
.enl{margin-left:auto;background:none;border:0;padding:0;font-weight:600;font-size:.88rem;cursor:pointer;text-decoration:underline;text-underline-offset:.2em;text-decoration-color:var(--line)}
.enl:hover{text-decoration-color:var(--brown)}
.thumbs{display:flex;gap:.4rem;overflow-x:auto;margin-top:.6rem;padding:3px;scrollbar-width:thin;max-width:100%}
.thumb{flex:0 0 auto;width:60px;aspect-ratio:16/10;padding:0;border:0;background:none;cursor:pointer;opacity:.5;border-radius:4px;overflow:hidden;transition:opacity .15s}
.thumb img{width:100%;height:100%;object-fit:cover}
.thumb:hover{opacity:.85}
.thumb[aria-current="true"]{opacity:1;outline:2px solid var(--brown);outline-offset:1px}


/* Study abroad */
.abroad{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(1.5rem,4vw,3rem);align-items:start;margin-top:1.75rem}
.abroad .media{margin-top:0}
.abroad .frame img{max-height:440px}
.abroad h3{margin:0 0 .15rem;font-size:1.3rem;font-weight:700}
.abroad .sub{margin:0 0 1rem;color:var(--soft)}
.abroad p{margin:0 0 1rem}
.abroad .de{font-weight:600}
.abroad .de span{display:block;font-weight:400;color:var(--soft);font-size:.95rem}
details.story{margin-top:2rem}
details.story summary{cursor:pointer;list-style:none;display:inline-flex;align-items:center;gap:.5rem;font-weight:600;padding:.55rem 1rem;border:1px solid var(--line);border-radius:999px;transition:border-color .2s}
details.story summary:hover{border-color:var(--brown)}
details.story summary::-webkit-details-marker{display:none}
details.story summary svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;transition:transform .2s}
details.story[open] summary svg{transform:rotate(180deg)}
details.story .tale{margin-top:1.25rem;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1.25rem 2.5rem}
details.story .tale p{padding-left:1.1rem;border-left:2px solid var(--line)}
details.story .tale p{margin:0;color:var(--soft)}
@media (max-width:760px){.abroad{grid-template-columns:minmax(0,1fr)}details.story .tale{grid-template-columns:minmax(0,1fr)}}

/* Projects */
.proj{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:clamp(1.25rem,4vw,2.75rem);align-items:start;padding:2rem 0;border-bottom:1px solid var(--line)}
.proj:last-child{border-bottom:0}
.proj .media{margin-top:0}
.proj h4{margin:0 0 .15rem;font-size:1.3rem;font-weight:700}
.proj .kind{margin:0 0 .75rem;color:var(--soft);font-size:.98rem}
.proj p.d{margin:0}

/* Skills */
.skills{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.25rem}
.sk{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1.1rem 1.1rem 1.2rem}
.sk h4{margin:0 0 .8rem;font-size:1.02rem;font-weight:700;display:flex;align-items:center;gap:.5rem}
.sk h4::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--tan);box-shadow:0 0 0 3px rgba(176,138,115,.22)}
.sk ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.45rem}
.sk li{font-size:.85rem;line-height:1.25;padding:.38rem .7rem;white-space:nowrap;border-radius:999px;background:var(--latte);border:1px solid var(--latte2);color:var(--brown);transition:background .2s,transform .2s}
.sk li:hover{background:var(--latte2);transform:translateY(-2px)}
.skills.pre .sk li{opacity:0;transform:translateY(10px)}
.skills.in .sk li{opacity:1;transform:none;transition:opacity .45s ease var(--d,0s),transform .45s ease var(--d,0s),background .2s}
.skills.in .sk li:hover{transform:translateY(-2px);transition-delay:0s}
@media (prefers-reduced-motion:reduce){.skills.pre .sk li{opacity:1;transform:none}}

/* Certifications */
.certs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.25rem;align-items:start;margin-top:2.5rem}
.cert{margin:0}
.cert .cimg{border-radius:8px;overflow:hidden;box-shadow:0 1px 3px rgba(78,50,39,.12)}
.cert img{width:100%;height:auto}
.cert figcaption{margin-top:.6rem;font-size:.9rem;line-height:1.4}
.cert .cn{display:block;font-weight:600}
.cert .cm{display:block;color:var(--soft)}

/* Recognition */
.honors{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 2.5rem}
.honor{padding:1.1rem 0;border-bottom:1px solid var(--line)}
.honor:last-child{border-bottom:0}
@media (min-width:861px){.honor:nth-last-child(2){border-bottom:0}}
.honor h4{margin:0;font-size:1.05rem;font-weight:700;line-height:1.35}
.honor .m{margin:.1rem 0 .35rem;color:var(--soft);font-size:.92rem}
.honor p{margin:0;font-size:.95rem}


/* Ticker */
.ticker{padding:1.5rem 0 2.75rem}
.ticker .tk{display:flex;align-items:center;gap:1.75rem}
.ticker .lbl{flex:none;font-size:.9rem;font-weight:600;color:var(--pink);background:var(--brown);padding:.45rem 1.1rem;border-radius:999px;box-shadow:0 1px 3px rgba(78,50,39,.25)}
.ticker .viewport{flex:1;min-width:0;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}
.ticker .track{display:flex;width:max-content;animation:tick 42s linear infinite;will-change:transform}
.ticker:hover .track{animation-play-state:paused}
.ticker .set{display:flex}
.ticker .item{display:inline-flex;align-items:center;gap:1.25rem;padding-right:1.25rem;font-size:1.02rem;font-weight:500;color:var(--soft);white-space:nowrap}
.ticker .item::after{content:"";width:4px;height:4px;border-radius:50%;background:rgba(78,50,39,.3)}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media (max-width:640px){.ticker .tk{flex-direction:column;align-items:flex-start;gap:.5rem}.ticker .viewport{width:100%;flex:none}}
@media (prefers-reduced-motion:reduce){.ticker .track{animation:none;width:auto}.ticker .set{flex-wrap:wrap;row-gap:.4rem}.ticker .set[aria-hidden]{display:none}.ticker .viewport{-webkit-mask-image:none;mask-image:none}}

footer{border-top:1px solid var(--line);padding:2.5rem 0 calc(env(safe-area-inset-bottom,0px) + 2.5rem)}
footer .wrap{display:flex;flex-wrap:wrap;gap:1rem 2rem;justify-content:space-between;align-items:center;font-size:.95rem}
footer .links{display:flex;gap:1.5rem}
footer .links a{text-decoration:none;font-weight:600}
footer .links a:hover{text-decoration:underline}
footer small{color:var(--soft)}

/* Lightbox */
dialog.lb{width:100vw;height:100%;max-width:100vw;max-height:100%;margin:0;padding:0;border:0;background:#2A1A17;color:#F8E4EA}
dialog.lb::backdrop{background:#2A1A17}
.lb-in{position:absolute;inset:0;display:grid;grid-template-rows:auto 1fr auto;padding:calc(env(safe-area-inset-top,0px) + 1rem) clamp(1rem,3vw,2rem) calc(env(safe-area-inset-bottom,0px) + 1rem)}
.lb-top{display:flex;justify-content:space-between;align-items:center;gap:1rem}
.lb-img{min-height:0;display:flex;align-items:center;justify-content:center;padding:1rem 0}
.lb-img img{max-width:100%;max-height:100%;object-fit:contain}
.lb-bar{display:flex;justify-content:space-between;align-items:center}
.lbtn{font-weight:600;font-size:.92rem;color:#F8E4EA;background:transparent;border:1px solid rgba(248,228,234,.35);border-radius:999px;padding:.55rem 1.2rem;cursor:pointer;min-height:44px}
.lbtn:hover{border-color:#F8E4EA}
.lbtn:disabled{opacity:.3;cursor:default}

@media (max-width:860px){
  .proj{grid-template-columns:minmax(0,1fr)}
  .skills,.certs{grid-template-columns:repeat(2,minmax(0,1fr))}
  .honors{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:640px){
  body{font-size:16px}
  .about{grid-template-columns:minmax(0,1fr)}
  .about img{max-width:300px}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr))}
  .row{grid-template-columns:minmax(0,1fr);gap:.2rem}
  .pills{flex-direction:column;align-items:stretch;width:min(300px,100%)}
  .frame img{max-height:280px}
  .row .frame img{max-height:220px}
}
@media (max-width:540px){.skills{grid-template-columns:minmax(0,1fr)}}
@media (max-width:420px){.namebox{padding:1rem .5rem}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;animation-delay:0s!important;transition-duration:.01ms!important}}
</style>
</head>
