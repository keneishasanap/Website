function slideshow(title,slides,thumbs,fs=true){
  let i=0,init=true;const n=slides.length;
  const img=el('img',{alt:'',decoding:'async'});
  const prev=el('button',{class:'arrow prev',type:'button','aria-label':'Previous'});prev.append(ic('chevL'));
  const next=el('button',{class:'arrow next',type:'button','aria-label':'Next'});next.append(ic('chevR'));
  const frame=el('div',{class:'frame',tabindex:'0','aria-label':`${title}. Use arrow keys to browse, Enter for full screen.`},img,prev,next);
  const count=el('span',{class:'count','aria-live':'polite'});
  const enl=fs?el('button',{class:'enl',type:'button'},'Full screen'):'';
  const showThumbs=n>5;const tw=el('div',{class:'thumbs'});
  const tb=showThumbs?thumbs.map((src,k)=>{const b=el('button',{class:'thumb',type:'button','aria-label':`Show ${k+1} of ${n}`},el('img',{src,alt:'',decoding:'async'}));b.onclick=()=>show(k);tw.append(b);return b}):[];
  function show(k){i=Math.max(0,Math.min(n-1,k));img.src=slides[i];img.alt=`${title}, ${i+1} of ${n}`;count.textContent=`${i+1} of ${n}`;prev.disabled=i===0;next.disabled=i===n-1;
    tb.forEach((b,k2)=>b.setAttribute('aria-current',k2===i?'true':'false'));
    if(showThumbs&&!init){const t=tb[i],tr=t.getBoundingClientRect(),sr=tw.getBoundingClientRect();tw.scrollTo({left:tw.scrollLeft+(tr.left-sr.left)-sr.width/2+tr.width/2,behavior:'smooth'})}init=false}
  prev.onclick=e=>{e.stopPropagation();show(i-1)};next.onclick=e=>{e.stopPropagation();show(i+1)};
  const open=()=>lbOpen(slides,i,title,show);if(fs){img.onclick=open;enl.onclick=open}else{img.style.cursor='default'}
  frame.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'){e.preventDefault();show(i-1)}if(e.key==='ArrowRight'){e.preventDefault();show(i+1)}if(fs&&e.key==='Enter'&&e.target===frame)open()});
  let sx=null;frame.addEventListener('touchstart',e=>{sx=e.touches[0].clientX},{passive:true});
  frame.addEventListener('touchend',e=>{if(sx===null)return;const dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>45)show(i+(dx<0?1:-1));sx=null});
  const fit=el('div',{class:'fit'},frame,el('div',{class:'sbar'},count,enl));const m=el('div',{class:'media'},fit);if(showThumbs)m.append(tw);show(0);return m;
}

